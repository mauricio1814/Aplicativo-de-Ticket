<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="data" />
          <add segment=".git" />
          <add segment="server.py" />
          <add segment="iniciar.bat" />
          <add segment="iniciar-iis.bat" />
          <add segment="README.md" />
          <add segment="boceto-ticket-mesa-ayuda.html" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Mesa de ayuda API hacia Python" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:5100/api/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
